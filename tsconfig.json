{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2017",
      "ES2016",
      "DOM"
    ],
    "jsx": "react",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": false,
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
